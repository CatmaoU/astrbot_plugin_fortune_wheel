                },
                {
                    "cmd": "/大礼包 @用户",
                    "desc": "替别人使用大礼包（有概率成功，失败时自己承担翻倍禁言时长）"
                },
                {
                    "cmd": "/大礼包历史",
                    "desc": "查看自己的抽奖历史记录"
